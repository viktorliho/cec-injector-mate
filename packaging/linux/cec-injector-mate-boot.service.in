[Unit]
Description=CEC Injector Mate explicit boot policy
After=systemd-udevd.service dbus.service
Before=cec-injector-mate.service

[Service]
Type=oneshot
User=cec-injector-mate
Group=cec-injector-mate
SupplementaryGroups=video
RuntimeDirectory=cec-injector-mate
StateDirectory=cec-injector-mate
UMask=0077
ExecStart=@EXECUTABLE@ --boot-once --startup-timeout 30 --device-id @DEVICE_ID@ --pa-cache /var/lib/cec-injector-mate/physical-address --runtime-config /etc/cec-injector-mate/runtime/config.conf
TimeoutStartSec=45s
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/cec-injector-mate
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
