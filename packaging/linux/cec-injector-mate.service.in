[Unit]
Description=CEC Injector Mate
After=cec-injector-mate-boot.service systemd-udevd.service dbus.service

[Service]
Type=simple
User=cec-injector-mate
Group=cec-injector-mate
RuntimeDirectory=cec-injector-mate
StateDirectory=cec-injector-mate
UMask=0077
ExecStart=@EXECUTABLE@ --device-id @DEVICE_ID@ --pa-cache /var/lib/cec-injector-mate/physical-address --uinput /dev/uinput --remote-profile steamos-parity --power-on-boot --power-on-resume --standby-on-suspend --standby-on-shutdown --suspend-on-tv-standby --wake-host-on-tv-source-request
Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=60s
StartLimitBurst=3
TimeoutStopSec=15s
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=yes
MemoryDenyWriteExecute=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/cec-injector-mate
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
