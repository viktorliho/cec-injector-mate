+int32_t CUSBCECAdapterCommunication::ProjectAdapterTransaction(
+    uint8_t command, const uint8_t* request, uint32_t requestSize,
+    uint8_t* response, uint32_t responseCapacity, uint32_t* responseSize,
+    uint32_t timeoutMs)
+{
+  if (responseSize)
+    *responseSize = 0;
+  if (command < 0xE0 || command > 0xE7 || requestSize > 64 ||
+      (requestSize && !request) || !response || !responseSize ||
+      responseCapacity == 0 || timeoutMs == 0)
+    return CEC_PROJECT_ADAPTER_INVALID_ARGUMENT;
+
+  CLockObject projectLock(m_projectMutex);
+  {
+    CLockObject stateLock(m_projectStateMutex);
+    if (m_projectResponseQuarantined)
+      return CEC_PROJECT_ADAPTER_TIMEOUT;
+    if (m_projectDisconnected)
+      return CEC_PROJECT_ADAPTER_DISCONNECTED;
+  }
+  if (!IsOpen() || !m_adapterMessageQueue)
+    return CEC_PROJECT_ADAPTER_NOT_OPEN;
+
+  CCECAdapterMessage* output = new CCECAdapterMessage;
+  output->project_command = command;
+  output->PushBack(MSGSTART);
+  output->PushEscaped(command);
+  for (uint32_t i = 0; i < requestSize; ++i)
+    output->PushEscaped(request[i]);
+  output->PushBack(MSGEND);
+  output->transmit_timeout = static_cast<int32_t>(timeoutMs);
+
+  const bool completed = m_adapterMessageQueue->Write(output);
+  if (!completed)
+  {
+    bool disconnected = !IsOpen() || !IsRunning();
+    {
+      CLockObject stateLock(m_projectStateMutex);
+      disconnected = disconnected || m_projectDisconnected;
+    }
+    delete output;
+    return disconnected ? CEC_PROJECT_ADAPTER_DISCONNECTED
+                        : CEC_PROJECT_ADAPTER_TIMEOUT;
+  }
+
+  if (output->m_rx_len < 3 || output->m_rx_data[0] != MSGSTART ||
+      output->m_rx_data[output->m_rx_len - 1] != MSGEND)
+  {
+    delete output;
+    return CEC_PROJECT_ADAPTER_MALFORMED_RESPONSE;
+  }
+
+  const uint8_t responseCommand = output->m_rx_data[1];
+  const bool direct = responseCommand == command;
+  const bool accepted = responseCommand == MSGCODE_COMMAND_ACCEPTED &&
+                        output->m_rx_len == 4 && output->m_rx_data[2] == command;
+  const bool rejected = responseCommand == MSGCODE_COMMAND_REJECTED &&
+                        output->m_rx_len == 4 && output->m_rx_data[2] == command;
+  if (!direct && !accepted && !rejected)
+  {
+    delete output;
+    return CEC_PROJECT_ADAPTER_MALFORMED_RESPONSE;
+  }
+
+  const uint32_t unframedSize = output->m_rx_len - 2;
+  if (unframedSize > responseCapacity)
+  {
+    delete output;
+    return CEC_PROJECT_ADAPTER_BUFFER_TOO_SMALL;
+  }
+  memcpy(response, &output->m_rx_data[1], unframedSize);
+  *responseSize = unframedSize;
+  delete output;
+  return rejected ? CEC_PROJECT_ADAPTER_REJECTED : CEC_PROJECT_ADAPTER_OK;
+}
+
+void CUSBCECAdapterCommunication::ProjectResponseTimedOut(uint8_t command)
+{
+  CLockObject stateLock(m_projectStateMutex);
+  m_projectResponseQuarantined = true;
+  m_projectQuarantinedCommand = command;
+}
+
+bool CUSBCECAdapterCommunication::DiscardLateProjectResponse(
+    const CCECAdapterMessage& message)
+{
+  CLockObject stateLock(m_projectStateMutex);
+  if (!m_projectResponseQuarantined)
+    return false;
+  const uint8_t responseCommand = message.At(1);
+  const bool direct = responseCommand == m_projectQuarantinedCommand;
+  const bool acceptedOrRejected =
+      (responseCommand == MSGCODE_COMMAND_ACCEPTED ||
+       responseCommand == MSGCODE_COMMAND_REJECTED) &&
+      message.At(2) == m_projectQuarantinedCommand;
+  if (!direct && !acceptedOrRejected)
+    return false;
+  m_projectResponseQuarantined = false;
+  return true;
+}
