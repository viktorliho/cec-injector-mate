+
+extern "C" DECLSPEC int32_t cec_project_adapter_transaction_v1(
+    void* adapter, uint8_t command, const uint8_t* request,
+    uint32_t requestSize, uint8_t* response, uint32_t responseCapacity,
+    uint32_t* responseSize, uint32_t timeoutMs)
+{
+  if (!adapter)
+    return 1;
+  try
+  {
+    CLibCEC* implementation = dynamic_cast<CLibCEC*>(
+        static_cast<ICECAdapter*>(adapter));
+    if (!implementation)
+      return 2;
+    return implementation->ProjectAdapterTransaction(
+        command, request, requestSize, response, responseCapacity, responseSize,
+        timeoutMs);
+  }
+  catch (...)
+  {
+    if (responseSize)
+      *responseSize = 0;
+    return 9;
+  }
+}
